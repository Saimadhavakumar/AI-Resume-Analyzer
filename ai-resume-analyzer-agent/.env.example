# Copy this file to .env and adjust Ollama settings
# OLLAMA_API_URL (defaults to http://localhost:11434 for a local server)
# OLLAMA_MODEL (defaults to llama2)
# OLLAMA_API_KEY (only required if your server enforces authentication)

OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=llama2
OLLAMA_API_KEY=YOUR_API_KEY_HERE
